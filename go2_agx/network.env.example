# Network settings for the go2_agx scripts. Copy this file to ~/.config/go2_agx/network.env on BOTH the Go2
# computer and the AGX (same values) and fill it in. The scripts refuse to start while a value is missing.
# Everything on the Go2 Jetson (no AGX): only the Go2 needs this file, and AGX_IP can stay empty.
# (Another location can be given with the environment variable GO2_AGX_CONF.)

# Address of the Go2 computer on its internal wired network (it runs the ROS 1 master).
GO2_IP=

# Optional: the site's point cloud (.pcd) that cloud_view.py shows in Foxglove (path as seen from the Go2 home).
# Without it the default ~/ons2/ros_ws/src/map_planner/maps/map.pcd is used. Example: ONS2_MAP_PCD=$HOME/ons2/ros_ws/src/map_planner/maps/restaurant.pcd
# ONS2_MAP_PCD=

# Static address given to the AGX on the Ethernet cable to the Go2 (same subnet as GO2_IP). Not needed without an AGX.
AGX_IP=
