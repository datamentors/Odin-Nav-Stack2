# GPU detector selection for start_yolo_gpu_agx.sh (and the watchdog / autostart, which start it without options).
# Copy to ~/.config/go2_agx/detector.env on the machine that runs the detector (AGX, or the Go2 in single-machine mode).
#
# Light per-frame detector: yolov5 (YOLOv5l, TensorRT engine with PyTorch fallback) | rfdetr (RF-DETR, TensorRT engine)
#   | yoloe (YOLOE, open vocabulary + masks: look for any words, changeable live with /perception/query or "find ..." in
#     the YOLO panel; image with WITH_YOLOE=1 and detector/get_models.sh yoloe)
DETECTOR=yolov5
# yoloe only: what to look for at start (comma separated; empty = the 80 COCO classes)
YOLOE_CLASSES=
# Tracker: none | iou | botsort | botsort_reid | sam2
#   iou           no extra packages; IDs per class, greedy IoU
#   botsort(_reid) and sam2 need the odin-gpu image built with --build-arg WITH_TRACKERS=1,
#   botsort_reid also detector/get_models.sh reid, sam2 also detector/get_models.sh sam2
TRACKER=none
# Weights (comma-separated fallbacks). Empty = defaults: yolov5 ~/odin_test/yolo_trt/yolov5l_fp16.engine then the .pt;
# rfdetr ~/odin_test/models/rfdetr_large_fp16.engine then rfdetr_medium_fp16.engine (detector/get_models.sh rfdetr);
# yoloe ~/odin_test/models/yoloe-11l-seg.pt, then -11m-, -11s- (yoloe-11l-seg-pf.pt = prompt-free, built-in vocabulary).
DETECTOR_WEIGHTS=
# Confidence threshold at start (live: /yolo/set_conf)
DETECTOR_CONF=0.25
# Size of the image the models get, in % of the camera image (1600 x 1296), downsampled with OpenCV INTER_AREA.
# Boxes, masks, 3D and the debug image stay at the original size. Empty = auto: longest side = the detector's input
# size (640 px for YOLOv5 / YOLOE, i.e. 40 %). Smaller = faster detection and tracking, fewer small/far objects.
# YOLOv5 and YOLOE then run at that smaller size; RF-DETR's engine has a fixed size. Live: /perception/set_scale.
DETECTOR_SCALE=
# sam2 tracker: the size SAM 2 works at (multiple of 32; 512 default, 384 / 256 faster, coarser masks) and the model.
# SAM2_MODE: video (default: SAM 2's video memory, follows the object across frames and knows when it is out of view)
#   | image (the image predictor re-prompted with the last box each frame, no memory: drifts, kept for comparison)
SAM2_IMAGE_SIZE=512
SAM2_MODEL=tiny
SAM2_MODE=video
# Following a target. Once a target is picked with a class (a box with a class name, "track person", Florence "track N"
# of a phrase that is a detector class), that class is detected down to FOCUS_CONF, and when the target is lost for
# REACQUIRE_FRAMES frames the best detection of the class (score >= ACQUIRE_CONF) becomes the target again (sam2: it
# restarts on it). The detectors score a suitcase or a far chair well below 0.25, hence the lower values.
FOCUS_CONF=0.1
ACQUIRE_CONF=0.2
REACQUIRE_FRAMES=5
# botsort(_reid): score for the first association / for starting a new track. BoxMOT's defaults (0.63 / 0.62, tuned on
# pedestrian benchmarks) left most suitcase and chair detections without a track.
BOTSORT_HIGH=0.3
BOTSORT_NEW=0.35
# yoloe: largest input size (multiple of 32)
YOLOE_IMGSZ=640
