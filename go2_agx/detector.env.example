# GPU detector selection for start_yolo_gpu_agx.sh (and the watchdog / autostart, which start it without options).
# Copy to ~/.config/go2_agx/detector.env on the machine that runs the detector (AGX, or the Go2 in single-machine mode).
#
# Light per-frame detector: yolov5 (YOLOv5l, TensorRT engine with PyTorch fallback) | rfdetr (RF-DETR, TensorRT engine)
DETECTOR=yolov5
# Tracker: none | iou | botsort | botsort_reid | sam2
#   iou           no extra packages; IDs per class, greedy IoU
#   botsort(_reid) and sam2 need the odin-gpu image built with --build-arg WITH_TRACKERS=1,
#   botsort_reid also detector/get_models.sh reid, sam2 also detector/get_models.sh sam2
TRACKER=none
# Weights (comma-separated fallbacks). Empty = defaults: yolov5 ~/odin_test/yolo_trt/yolov5l_fp16.engine then the .pt;
# rfdetr ~/odin_test/models/rfdetr_large_fp16.engine then rfdetr_medium_fp16.engine (detector/get_models.sh rfdetr).
DETECTOR_WEIGHTS=
# Confidence threshold at start (live: /yolo/set_conf)
DETECTOR_CONF=0.25
