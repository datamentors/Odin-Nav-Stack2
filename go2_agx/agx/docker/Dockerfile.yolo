# Image odin-yolo:0144 - ROS 1 Noetic + YOLOv5 runtime on top of odin-drv:0144 (CPU PyTorch: the ROS Noetic container is
# Python 3.8; the NVIDIA GPU wheels for JetPack 6 are Python 3.10, so the GPU part runs outside, see detector/).
# Used on the AGX as the ONE container "odin-agx" (see agx/agx_lib.sh): it runs the Odin1 driver, depth, the YOLO detector
# node and the Florence-2 frame server and relay as processes. odin-drv:0144 is only its build base.
# Build from the REPOSITORY ROOT (needs the yolov5 submodule):
#   git submodule update --init yolov5
#   docker build -f go2_agx/agx/docker/Dockerfile.yolo -t odin-yolo:0144 .      (--build-arg DRV_IMAGE=<tag> for another driver image;
#   Dockerfile.yolo.dockerignore next to this file replaces the root .dockerignore, which drops yolov5 and yolo_ros)
ARG DRV_IMAGE=odin-drv:0144
FROM ${DRV_IMAGE}
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      python3-pip ros-noetic-vision-msgs ros-noetic-tf2-ros ros-noetic-tf2-geometry-msgs python3-opencv \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir "numpy<1.25" torch==2.4.1 torchvision==0.19.1 --index-url https://download.pytorch.org/whl/cpu \
 && pip3 install --no-cache-dir "numpy<1.25" "ultralytics==8.3.40" pandas seaborn scipy tqdm psutil thop gitpython \
      requests pyyaml pillow loguru \
 && pip3 uninstall -y opencv-python opencv-python-headless || true
COPY yolov5 /opt/odin/yolov5
COPY ros_ws/src/yolo_ros /opt/odin/ros_ws/src/yolo_ros
RUN bash -c "source /opt/ros/noetic/setup.bash && cd /opt/odin/ros_ws && \
      catkin_make_isolated --merge --pkg yolo_ros --cmake-args -DCMAKE_BUILD_TYPE=Release -DPYTHON_EXECUTABLE=/usr/bin/python3" \
 && chmod +x /opt/odin/ros_ws/src/yolo_ros/scripts/*.py
# The system numpy 1.17 shadows the one pandas/ultralytics need; libgomp static TLS error on Jetson
RUN pip3 install --no-cache-dir "numpy==1.24.4"
# Odin-perception code (pinned commit + our patch) for the Florence-2 frame server: it used to be mounted from the host
ARG ODIN_PERCEPTION_COMMIT=9bc24a030fb2f6936c904a095e482b717fcf987d
RUN apt-get update && apt-get install -y --no-install-recommends git patch ca-certificates && rm -rf /var/lib/apt/lists/* \
 && git clone https://github.com/ManifoldTechLtd/Odin-perception.git /opt/odin-perception \
 && git -C /opt/odin-perception checkout $ODIN_PERCEPTION_COMMIT
COPY go2_agx/patches/odin-perception-annotation-boxes.patch /tmp/perc.patch
RUN git -C /opt/odin-perception apply /tmp/perc.patch
LABEL odin.perception=baked
ENV LD_PRELOAD=/lib/aarch64-linux-gnu/libgomp.so.1
# The headless launch file (driver only, no rviz) that start_odin_agx.sh uses; the upstream package has only odin1_ros1.launch.
# Last on purpose: cheap to change.
COPY go2_agx/agx/docker/odin1_headless.launch /opt/odin/ros_ws/src/odin_ros_driver/launch_ROS1/odin1_headless.launch

