{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "odin.nav.v1",
  "description": "Mission state from /waypoint_manager/status. Status (retained), on change and every 10 s.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "seq", "t_robot", "state"],
  "properties": {
    "kind": {"const": "odin.nav.v1"},
    "seq": {"type": "integer", "minimum": 0},
    "t_robot": {"type": "number"},
    "state": {"type": "string", "minLength": 1},
    "mission_id": {"type": "string"},
    "waypoint_idx": {"type": "integer", "minimum": 0},
    "total_waypoints": {"type": "integer", "minimum": 0},
    "goal": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"}
      }
    },
    "distance_to_target_m": {"type": "number", "minimum": 0},
    "progress_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "linear_vel": {"type": "number"},
    "angular_vel": {"type": "number"},
    "event": {"type": "string"}
  }
}
