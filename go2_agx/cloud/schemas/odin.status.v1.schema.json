{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "odin.status.v1",
  "description": "Full state of the Odin1 + ONS2 stack in one message: map in use, mission state, health. Status topic (retained on the cloud side, one slot, so everything is in one message). Sent on change (at most 1/s), every 2 s while NAVIGATING, otherwise every 10 s.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "seq", "t_robot", "map", "nav", "stack"],
  "properties": {
    "kind": {"const": "odin.status.v1"},
    "seq": {"type": "integer", "minimum": 0},
    "t_robot": {"type": "number", "description": "Robot clock, unix seconds"},
    "map": {
      "type": ["object", "null"],
      "description": "null until the map topic has been seen",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "resolution_m": {"type": "number", "exclusiveMinimum": 0},
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "yaw"],
          "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "yaw": {"type": "number"}}
        },
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reloc_map": {"type": ["string", "null"], "description": "Odin1 relocalization map file"},
        "s3_key": {"type": ["string", "null"], "description": "Map image in S3 (later phase)"}
      }
    },
    "nav": {
      "type": ["object", "null"],
      "description": "Mission state from /waypoint_manager/status; null until seen",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {"type": "string", "minLength": 1},
        "mission_id": {"type": "string"},
        "waypoint_idx": {"type": "integer", "minimum": 0},
        "total_waypoints": {"type": "integer", "minimum": 0},
        "goal": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {"x": {"type": "number"}, "y": {"type": "number"}}
        },
        "distance_to_target_m": {"type": "number", "minimum": 0},
        "progress_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "linear_vel": {"type": "number"},
        "angular_vel": {"type": "number"}
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs"],
      "properties": {
        "inputs": {
          "type": "object",
          "description": "Per input: seconds since the last message (null = never seen)",
          "additionalProperties": {"type": ["number", "null"], "minimum": 0}
        },
        "yolo_hz": {"type": "number", "minimum": 0},
        "images": {"type": "object", "additionalProperties": {"type": "string"}},
        "commit": {"type": "string"}
      }
    }
  }
}
