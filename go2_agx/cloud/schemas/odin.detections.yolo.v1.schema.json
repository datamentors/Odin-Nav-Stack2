{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "odin.detections.yolo.v1",
  "description": "YOLO detections with depth (from /yolo_detections_3d). Telemetry, up to 2 Hz, only when the list changes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "seq", "t_robot", "objects"],
  "properties": {
    "kind": {"const": "odin.detections.yolo.v1"},
    "seq": {"type": "integer", "minimum": 0},
    "t_robot": {"type": "number"},
    "image_stamp": {"type": "number", "description": "Unix seconds of the camera frame"},
    "objects": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "confidence"],
        "properties": {
          "class": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "distance_m": {"type": "number", "minimum": 0},
          "bearing_deg": {"type": "number", "minimum": -180, "maximum": 180},
          "map_x": {"type": ["number", "null"]},
          "map_y": {"type": ["number", "null"]}
        }
      }
    }
  }
}
